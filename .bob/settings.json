{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .bob/assets/tools/serve.js --ensure",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^use_skill$",
        "hooks": [
          {
            "type": "command",
            "command": "node .bob/assets/tools/log-skill.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
