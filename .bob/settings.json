{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .bob/assets/tools/skills.js start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .bob/assets/tools/skills.js build",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^use_skill$",
        "hooks": [
          {
            "type": "command",
            "command": "node .bob/assets/tools/skills.js log",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
